{
  "name": "tw-job-hunter",
  "version": "0.9.1",
  "description": "104 與 Yourator 職缺搜尋、公司研調、PDF 履歷無損解析，以及求職流程、適配度分析、履歷調整建議、求職自傳與自薦信擬定 Skills（研究學習用途，非官方）",
  "license": "MIT",
  "author": {
    "name": "Poorgramer-Zack",
    "url": "https://github.com/Poorgramer-Zack"
  },
  "homepage": "https://github.com/Poorgramer-Zack/tw-job-hunter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Poorgramer-Zack/tw-job-hunter.git"
  },
  "keywords": [
    "opencode-plugin",
    "pi-package",
    "mcp",
    "skills",
    "job-search",
    "taiwan",
    "104",
    "yourator",
    "resume",
    "cover-letter"
  ],
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/opencode-plugin.js"
  },
  "files": [
    "dist/",
    "skills/",
    ".claude-plugin/",
    ".codex-plugin/",
    ".antigravity-plugin/",
    ".agents/plugins/",
    ".opencode/",
    "mcp_config.json",
    "LICENSE",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./dist/pi-extension.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "check:dist": "npm run build && git diff --exit-code dist/"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tavily/core": "^1.1.0",
    "node-html-parser": "^9.0.7",
    "playwright": "^1.65.1",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
